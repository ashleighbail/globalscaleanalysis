/* Assignment: Mapping the world's deep ocean ecosystems */

var snazzy = require("users/aazuspan/snazzy:styles");
snazzy.addStyle("https://snazzymaps.com/style/72543/assassins-creed-iv", "Theme")

// Part 1. Import the data
var global_elevation = ee.Image("NOAA/NGDC/ETOPO1");
print (global_elevation);

var bedrock = global_elevation.select('bedrock');
bedrock = bedrock.updateMask(bedrock.lt(0));
print(bedrock);

var magma_palette = ['#000004', '#180f3d', '#440f76', '#721f81', '#9e2f7f', '#cd4071', '#f1605d', '#fd9668', '#feca8d', '#fcfdbf'];
Map.addLayer(bedrock, {min: -6000, max: 0, palette: magma_palette}, 'Seabed elevation');

// Coastline
var coast = ee.FeatureCollection('projects/UQ_intertidal/dataMasks/naturalEarthCoastline_v1');
Map.addLayer(coast, {color: '222222'}, 'Coastline');

// Part 2. Build a raster map of each of the following major ecosystem types.
/* Hadal trenches and troughs (> 6000 m)
   Abyssal plains (3000 - 6000 m)
   Continental and island slopes (250 - 3000 m)
   Submarine canyons (deeper than 200 m, slopes of > 6 degrees) */
   
var hadal = bedrock.lt(-6000).selfMask();
Map.addLayer(hadal, {min: 0, max: 1, palette: ['29205C']}, 'Hadal trenches and troughs');

var abyssal = bedrock.gte(-6000)
  .and(bedrock.lte(-3000))
  .selfMask();
Map.addLayer(abyssal, {min: 0, max: 1, palette: ['164B83']}, 'Abyssal plains');

var continental = bedrock.gt(-3000)
  .and(bedrock.lte(-250))
  .selfMask();
Map.addLayer(continental, {min: 0, max: 1, palette: ['3996B8']}, 'Continental and island slopes');

var terrain = ee.Terrain.products(bedrock);
var slope = terrain.select('slope');

var canyons = bedrock.lt(-200)
  .and(slope.gt(6))
  .selfMask();
Map.addLayer(canyons, {min: 0, max: 1, palette: ['red']}, 'Submarine canyons');

// Part 3. Add at least one vector dataset

// a. Marine Protected Areas (IUCN Categories)

var protected_areas = ee.FeatureCollection('WCMC/WDPA/current/polygons');
print (protected_areas.limit(50))

var marine_protected = protected_areas
  .filter(ee.Filter.inList('REALM', ['Coastal', 'Marine']))
  .filter(ee.Filter.neq('STATUS', 'Proposed'));
  
var strict_wilderness = marine_protected.filter(
  ee.Filter.inList('IUCN_CAT', ['Ia', 'Ib'])
);
print('Strict reserves and wilderness areas', strict_wilderness.size());
var nat_park = marine_protected.filter(
  ee.Filter.inList('IUCN_CAT', ['II', 'III'])
);
print('National parks and natural monuments', nat_park.size());
var habitat_management = marine_protected.filter(
  ee.Filter.eq('IUCN_CAT', 'IV')
);
print('Habitat/species management areas', habitat_management.size());
var landscape_sustainable = marine_protected.filter(
  ee.Filter.inList('IUCN_CAT', ['V', 'VI'])
);
print('Protected landscapes/seascapes and sustainable-use areas', landscape_sustainable.size());
var category_unknown = marine_protected.filter(
  ee.Filter.inList('IUCN_CAT', [
    'Not Assigned',
    'Not Reported',
    'Not Applicable'
  ])
);
print('Category unavailable or not applicable', category_unknown.size());

print('Marine protected area count', marine_protected.size());

var protected_style = {
  color: 'db00b6',
  fillColor: '00000000',
  width: 1
};

// Map.addLayer(marine_protected.style(protected_style), {}, 'Marine and coastal protected areas');

Map.addLayer(category_unknown.style({
    color: 'AAAAAA',
    fillColor: '00000000',
    width: 1
  }), {}, 'MPAs: category unavailable or not applicable');
Map.addLayer(strict_wilderness.style({color: 'ff7096'}),{},'MPAs: strict reserves and wilderness areas', true, 0.7);
Map.addLayer(nat_park.style({color: 'aacc00'}),{},'MPAs: national parks and natural monuments', true, 0.7);
Map.addLayer(habitat_management.style({color: 'f9dc5c'}),{},'MPAs: habitat/species management areas', true, 0.7);
Map.addLayer(landscape_sustainable.style({color: '42a5f5'}),{},'MPAs: protected landscapes/seascapes and sustainable-use areas', true, 0.7);

