function addLegendRow(color, description) {
  var colorBox = ui.Label({
    value: '',
    style: {
      backgroundColor: color,
      padding: '8px',
      margin: '0 8px 4px 0'
    }
  });

  var label = ui.Label({
    value: description,
    style: {
      margin: '0 0 4px 0',
      fontSize: '12px'
    }
  });

  var row = ui.Panel({
    widgets: [colorBox, label],
    layout: ui.Panel.Layout.Flow('horizontal')
  });

  legend.add(row);
}

