// Workshop 3

var population = ee.ImageCollection("CIESIN/GPWv411/GPW_Population_Count");
print (population);
var nl = ee.ImageCollection("NOAA/DMSP-OLS/NIGHTTIME_LIGHTS");
print (nl);
// Import two images for start and end
var population_2000 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2000_30_sec');
var population_2015 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2015_30_sec');
print (population_2000);
print (population_2015);
var population_vis = {
  'max': 1000.0,
  'palette': [
    'ffffe7',
    '86a192',
    '509791',
    '307296',
    '2c4484',
    '000066'
  ],
  'min': 0.0
};
Map.addLayer(population_2000, population_vis, 'population_count_2000');
Map.addLayer(population_2015, population_vis, 'population_count_2015');

// Same for nl dataset
var nl_2000 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F142000');
var nl_2013 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F182013');
print (nl_2000);
print (nl_2013);
var nl_2000 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F142000').select(['avg_vis'], ['nightlight']) 
var nl_2013 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F182013').select(['avg_vis'], ['nightlight'])
print ('nightlight 2000 processed', nl_2000)
var nighttimeLightsVis = {
  'max': 63,
  'palette':[
  'black',
  '013a63',
  '01497c',
  '014f86',
  '2a6f97',
  '2c7da0',
  ],
  min: 0
};
Map.addLayer(nl_2000, nighttimeLightsVis, 'Nighttime Lights 2000');
Map.addLayer(nl_2013, nighttimeLightsVis, 'Nighttime Lights 2013');

var worldgrid_5deg = ee.FeatureCollection('users/murrnick/mb5370/worldgrid_5deg'); // 5 degree grid
var worldgrid_2deg = ee.FeatureCollection('users/murrnick/mb5370/worldgrid_2deg'); // 2 degree grid
var worldgrid_1deg = ee.FeatureCollection('users/murrnick/mb5370/worldgrid_1deg'); // 1 degree grid

Map.addLayer(worldgrid_1deg, {color: 'green'}, '1 degree grid', false);
Map.addLayer(worldgrid_2deg, {color: 'green'}, '2 degree grid', false);
Map.addLayer(worldgrid_5deg, {color: 'green'}, '5 degree grid', false);

// Coastline import
var coast = ee.FeatureCollection('projects/UQ_intertidal/dataMasks/naturalEarthCoastline_v1')
Map.addLayer(coast, {color: 'yellow'}, 'Coastline')

var coastGrid = worldgrid_1deg.filterBounds(coast);
Map.addLayer(coastGrid, {color: 'red'}, 'Coastal 1 degree grid', false);

// Filter grids to bounds
var coast_grid = worldgrid_1deg
  .filter(ee.Filter.bounds(coast))
//  .filter(ee.Filter.bounds(geometry)) // limited area for testing
Map.addLayer(coast_grid, {color: 'white'}, 'Coastal grid (1 deg)', true, 0.7);

// Global change
var pop_change = population_2015
  .subtract(population_2000)
//  .clip(geometry)
Map.addLayer(pop_change, {palette: ['red', 'black', 'fuchsia'], min:-500, max:500}, 'Population change', true, 0.9)

var nl_change = nl_2013
  .subtract(nl_2000)
  .updateMask(population_2015.mask()) // to exclude ocean light
//  .clip(geometry)
Map.addLayer(nl_change, {palette: ['red', 'black', 'lightblue'], min:-50, max: 50}, 'Nightlight change', true, 0.9)

// Average change in population per [grid]
var pop_changePerGrid = pop_change.reduceRegions({
  collection: coast_grid,
  reducer: ee.Reducer.mean(),
  scale: 1000,
});
print ('Average change in population per grid', pop_changePerGrid.first());

// Average change in nightlights per [grid]
var nl_changePerGrid = nl_change.reduceRegions({
  collection: coast_grid,
  reducer: ee.Reducer.mean(),
  scale: 1000, // note: computing at a larger scale for speed
});
print ('Average change in nightlights per grid', nl_changePerGrid.first());

// Export the result to asset
Export.table.toAsset({
  collection: pop_changePerGrid,
  description: 'export_pop_toAsset',
  assetId: 'pop_changePerGrid'
});

Export.table.toAsset({
  collection: nl_changePerGrid,
  description: 'export_nl_toAsset',
  assetId: 'nl_changePerGrid'
});










