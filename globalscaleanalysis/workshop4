// Workshop 4: Allen Coral Atlas
/* The purpose of this script is to understand which research station has the most coral cover
within snorkelling distance from the station */

var distance = 300 // metre limit from the station for snorkelling

Map.setOptions('SATELLITE');
// Map.setCenter( 133.775, -25.274, 3) // Zoom out to view all stations

var stations = ee.FeatureCollection([Heron, Hamilton, Lizard, Daydream, Orpheus, Moreton, GumpSouthPacific, OneTree, CoralBay, Kimberley]);
print (stations);

var allencoralatlas = ee.Image("ACA/reef_habitat/v2_0");
print  (allencoralatlas);

var benthic = allencoralatlas.select('benthic');
print (benthic);
Map.addLayer (benthic, {min: 0, max: 18, palette: allencoralatlas.get('benthic_class_palette').getInfo()}, 'ACA: Benthic', false);

var coral_algae = benthic.eq(15);
print (coral_algae);
coral_algae = coral_algae.selfMask();
Map.addLayer (coral_algae, {palette: 'ff6161'}, 'Coral / Algae');

var buffered = ee.Feature(stations.first())
   .buffer(distance);
   
var buffered_style = {color: 'b8c0ff', fillColor: '00000000', width: 3 };

// Write a function that applies a buffer
var bufferer = function(feature) {
  var buffered = feature.buffer(distance)
  return buffered;
};

var bufferedStations = stations.map(bufferer);
print (bufferedStations);
Map.addLayer (bufferedStations.style(buffered_style), {}, '300m Distance Buffer');

// Calculate area of coral within buffer
var coral_area = coral_algae
  .multiply (ee.Image.pixelArea())
  .reduceRegions({
    reducer: ee.Reducer.sum(),
    collection: bufferedStations,
    scale: 5
  });
  
print ('Area of coral/algae within buffer(m)', coral_area)

var coral_buffered = coral_algae.clip(bufferedStations);
Map.addLayer (coral_buffered, {min:0, max: 1, palette: 'fdc500'}, 'Coral/Algae Buffered Area')

var coral_area = coral_area.sort('sum', false);

print('Coral area ranked largest to smallest', coral_area);

// Download (not to Google Drive)
var downloadLink = coral_area.getDownloadURL({
  format: 'CSV',
  filename: 'research_stations'
});
print('Download results as CSV', downloadLink);

